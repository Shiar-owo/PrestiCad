@startuml
title Contexto: Gestión de Préstamos y Reservas\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam class<<Entity>> {
  BackgroundColor #E1F5FE
  BorderColor #0288D1
  FontColor #01579B
}

skinparam note {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADOS Y OBJETOS DE VALOR
' ============================================================

class Prestamo <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  __ Fechas __
  fechaEntrega : DateTime
  fechaLimiteDevolucion : DateTime
  tiempoPrestamoDias : Integer
  __ Estado __
  -estado : EstadoPrestamo
  activo : Boolean
  __ Observaciones __
  observaciones : String
  --
  +crear(usuario, material, dias) : Prestamo
  +activar(garantia) : void
  +devolver(checklist) : void
  +vencer() : void
  +solicitarProrroga(disp, tier) : Boolean
  +calcularDiasRestantes() : Integer
}

class EstadoPrestamo <<Value Object>> {
  RESERVADO
  ACTIVO
  DEVUELTO
  VENCIDO
  --
  +transicionesPermitidas() : List
}

class Reserva <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  __ Datos __
  fechaHoraRecojo : DateTime
  justificacion : String
  __ Clasificacion __
  -prioridad : PrioridadReserva
  -estado : EstadoReserva
  __ Metadata __
  fechaCreacion : DateTime
  activa : Boolean
  --
  +crear(usuario, material, prio, just) : Reserva
  +cancelarPorVencimiento() : void
  +convertirAPrestamo() : Prestamo
  +estaVigente() : Boolean
  +expiro() : Boolean
}

class EstadoReserva <<Value Object>> {
  RESERVADA
  CANCELADA_POR_VENCIMIENTO
  CONVERTIDA_EN_PRESTAMO
}

class PrioridadReserva <<Value Object>> {
  ALTA
  MEDIA
  BAJA
  --
  +esPrioritaria() : Boolean
}

class Prorroga <<Entity>> {
  id : UUID
  fechaSolicitud : DateTime
  diasExtension : Integer
  aprobada : Boolean
  motivo : String
  --
  +solicitar(prestamo, tier) : Boolean
  +aprobar() : void
  +rechazar(motivo) : void
}

' ============================================================
' RELACIONES
' ============================================================

Prestamo *-- EstadoPrestamo
Prestamo "0..*" -- Prorroga
Reserva *-- EstadoReserva
Reserva *-- PrioridadReserva

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of Prestamo
  <b>RN04 - Vigencia de Reservas</b>
  ═══════════════════════════════════════
  Máximo 24 horas desde hora pactada
  de recojo
  ──────────────────────────────────────
  Sin recoger → "Cancelada por Vencimiento"
  Material vuelve a "Disponible"
  Penalización por inasistencia al
  puntaje de reputación del usuario
end note

note right of Reserva
  <b>RN08 - Control de Concurrencia</b>
  ═══════════════════════════════════════
  Reservas simultáneas para el mismo
  objeto se procesan con transacciones
  atómicas (prevenir race conditions)
  sobre la última unidad disponible
  ──────────────────────────────────────
  <b>RN07 - Prórrogas</b>
  Condicionadas a:
  • Disponibilidad del bien
  • Tier de reputación del usuario
  Prioridad para Tier Avanzado
end note

note bottom of Prorroga
  <b>RF12 - Solicitud de Prórroga</b>
  ═══════════════════════════════════════
  Evaluación automática de elegibilidad:
  • Tier de reputación del usuario
  • Disponibilidad del bien
  • Prioridad para Tier Avanzado
end note

note left of EstadoPrestamo
  <b>RF07 - Estados del Préstamo</b>
  ═══════════════════════════════════════
  RESERVADO → ACTIVO → DEVUELTO
                  ↘ VENCIDO
end note

@enduml
