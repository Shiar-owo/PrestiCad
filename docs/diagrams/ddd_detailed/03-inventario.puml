@startuml
title Contexto: Gestión de Inventario\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam note {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADOS Y OBJETOS DE VALOR
' ============================================================

class Material <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  nombre : String
  descripcion : String
  codigo_inventario : String
  __ Clasificacion __
  -tipo : TipoMaterial
  -estado : EstadoMaterial
  es_alto_valor : Boolean
  __ Configuracion __
  -atributosRep : AtributosReputacion
  __ Inventario __
  stock : Integer
  __ Propiedades Derivadas __
  +total_instancias : Integer
  +resumen_estados : Dict
  __ Metadata __
  created_at : DateTime
  updated_at : DateTime
  --
  +cambiarEstado(nuevo) : void
  +estaDisponible() : Boolean
  +requiereGarantia() : Boolean
  +obtenerTierMinimo() : Tier
}

class InstanciaMaterial <<Entity>> {
  --
  __ Identidad __
  id : UUID
  material_id : UUID
  codigo_ejemplar : String
  numero_serie : String
  __ Estado y Condición __
  -estado : EstadoInstancia
  estado_fisico : String
  observaciones : String
  ubicacion : String
  __ Metadata __
  created_at : DateTime
  updated_at : DateTime
  --
  +cambiarEstado(nuevo) : void
  +estaDisponible() : Boolean
  +darDeBaja(motivo) : void
}

class EstadoInstancia <<Value Object>> {
  DISPONIBLE
  RESERVADO
  PRESTADO
  EN_MANTENIMIENTO
  DE_BAJA
  --
  +esDisponible() : Boolean
  +puedePrestarse() : Boolean
}

class EstadoMaterial <<Value Object>> {
  DISPONIBLE
  EN_MANTENIMIENTO
  RESERVADO
  PRESTADO
  --
  +esDisponible() : Boolean
  +puedePrestarse() : Boolean
}

class TipoMaterial <<Value Object>> {
  EQUIPO
  LIBRO
  OBJETO
}

class FichaTecnica <<Value Object>> {
  marca : String
  modelo : String
  numero_serie : String
  color : String
  estado_fisico : String
  foto : Image
}

class AtributosReputacion <<Value Object>> {
  __ Penalizaciones __
  tier_minimo_requerido : Tier
  bonificacion_tiempo : Integer
  deduccion_tardanza : Integer
  deduccion_dano_parcial : Integer
  deduccion_dano_total : Integer
  __ Costos __
  costo_reparacion : Decimal
  costo_reposicion : Decimal
  --
  +calcularBonificacion() : Integer
  +calcularDeduccionTardanza(dias) : Integer
  +calcularDeduccionDano(tipo) : Integer
}

' ============================================================
' RELACIONES
' ============================================================

Material *-- EstadoMaterial
Material *-- TipoMaterial
Material "0..1" *-- FichaTecnica
Material *-- AtributosReputacion
Material "1" *-- "1..*" InstanciaMaterial : posee ejemplares >
InstanciaMaterial *-- EstadoInstancia

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of Material
  <b>RN01 - Disponibilidad de Materiales</b>
  ═══════════════════════════════════════
  Un material tiene disponibilidad mientras
  cuente con al menos una instancia física
  en estado <b>"Disponible"</b>
  ──────────────────────────────────────
  Estados de instancia que no prestan:
  • En Mantenimiento
  • Reservado
  • Prestado
  • De Baja
end note

note bottom of AtributosReputacion
  <b>RN06 - Cálculo Dinámico por Objeto</b>
  ═══════════════════════════════════════
  Cada objeto tiene parametrizado:
  • Bonificación por entrega a tiempo
  • Deducción por tardanza (proporcional)
  • Deducción por daño parcial
  • Deducción por daño total
  • Costo reparación/reposición
  ──────────────────────────────────────
  Las sanciones se calculan usando
  estos parámetros al momento de
  la devolución
end note

note right of Material
  <b>RN05 - Garantía para Alto Valor</b>
  ═══════════════════════════════════════
  Equipos de alto valor requieren:
  • Documento de identidad
  • Compromiso de responsabilidad firmado
  ──────────────────────────────────────
  Ejemplos: laptops, proyectores, cámaras
end note

note right of EstadoInstancia
  <b>RF03 - Estados de Instancia</b>
  Control individual de ciclo
  de vida de cada ejemplar físico
end note

note bottom of Material
  <b>Implementado en HU04 / HU05</b>
  ═══════════════════════════════
  • <b>Material</b>: catálogo general y configuración de reputación.
  • <b>InstanciaMaterial</b>: ejemplares físicos individuales con
    `codigo_ejemplar`, `numero_serie`, `estado_fisico`, `ubicacion`.
  • <b>stock</b>: sincronizado automáticamente con total de instancias.
  • <b>resumen_estados</b>: disponibilidad en tiempo real para catálogo.
  • Endpoints: `/api/materiales/<id>/instancias/` y `/api/instancias/<id>/`
end note

@enduml
