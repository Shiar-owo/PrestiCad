@startuml
title Vista General - Contextos Delimitados\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 12
  defaultFontName "Segoe UI"
  linetype ortho
  roundcorner 10
  padding 15
}

skinparam rectangle<<context>> {
 FontSize 14
FontStyle bold
BorderThickness 2
RoundCorner 15
}

skinparam rectangle<<ctx-usuario>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
}

skinparam rectangle<<ctx-inventario>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}

skinparam rectangle<<ctx-prestamos>> {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
}

skinparam rectangle<<ctx-reputacion>> {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
  FontColor #4A148C
}

skinparam rectangle<<ctx-garantia>> {
  BackgroundColor #FBE9E7
  BorderColor #BF360C
  FontColor #BF360C
}

skinparam rectangle<<ctx-inspeccion>> {
  BackgroundColor #E0F7FA
  BorderColor #00695C
  FontColor #004D40
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #FBC02D
  FontColor #5D4037
  FontSize 10
}

' ============================================================
' CONTEXTOS
' ============================================================

rectangle "  <b>Gestión de Usuarios</b>\n----\n<color:#546E7A>Registro, autenticación\nReputación, Tiers</color>  " <<ctx-usuario>> as CTX1

rectangle "  <b>Gestión de Inventario</b>\n----\n<color:#546E7A>Materiales, disponibilidad\nConfiguración por objeto</color>  " <<ctx-inventario>> as CTX2

rectangle "  <b>Gestión de Préstamos\ny Reservas</b>\n----\n<color:#546E7A>Ciclo de vida:\nreserva → préstamo → devolución</color>  " <<ctx-prestamos>> as CTX3

rectangle "  <b>Sistema de Reputación\ny Sanciones</b>\n----\n<color:#546E7A>Cálculo dinámico de puntos\nTiers, sanciones</color>  " <<ctx-reputacion>> as CTX4

rectangle "  <b>Sistema de Garantías</b>\n----\n<color:#546E7A>Documento de identidad\n+ compromiso firmado</color>  " <<ctx-garantia>> as CTX5

rectangle "  <b>Sistema de Inspección</b>\n----\n<color:#546E7A>Checklist digital\nde estado</color>  " <<ctx-inspeccion>> as CTX6

' ============================================================
' RELACIONES ENTRE CONTEXTOS
' ============================================================

CTX1 --> CTX3 : <color:#546E7A>Usuario crea reservas\ny es titular de préstamos</color>
CTX2 --> CTX3 : <color:#546E7A>Material es el bien\nprestado/reservado</color>
CTX3 --> CTX5 : <color:#546E7A>Préstamo requiere\ngarantía (alto valor)</color>
CTX3 --> CTX6 : <color:#546E7A>Préstamo tiene\nchecklist</color>
CTX3 --> CTX4 : <color:#546E7A>Devolución genera\nsanciones</color>
CTX4 --> CTX1 : <color:#546E7A>Sanciones actualizan\nreputación del usuario</color>
CTX5 --> CTX1 : <color:#546E7A>Garantía es entregada\npor un usuario</color>

' ============================================================
' REGLAS DE NEGOCIO CLAVE
' ============================================================

note top of CTX1
  <b>RN03 - Reputación y Tiers</b>
  Rango: [-500, 500] | Inicio: 0
  ─────────────────────────────
  ● Avanzado [201..500]
  ● Estándar [-50..200]
  ● Restringido [-500..-51]
  <i>Excepción Académica:</i>
  Doc. identidad + Compromiso firmado
end note

note bottom of CTX2
  <b>RN01 - Disponibilidad</b>
  Solo se presta si "Disponible"
  ─────────────────────────────
  <b>RN05 - Garantía</b>
  Equipos alto valor: doc. + compromiso
end note

note right of CTX3
  <b>RN04 - Vigencia Reservas</b>
  Máximo 24h desde recojo
  Sin recoger → Cancelada
end note

note bottom of CTX4
  <b>RN06 - Cálculo Dinámico</b>
  ● Bonificación por entrega a tiempo
  ● Descuento proporcional tardanza
  ● Penalización severa por daño
  <b>RF08:</b> Cobros SOLO por daño físico
end note

note bottom of CTX6
  <b>RN09 - Checklist Digital</b>
  ● Obligatorio al entregar (CU03)
  ● Obligatorio al devolver (CU04)
  ● Sanciones solo por daños NUEVOS
end note

legend bottom
  |= Contexto |= Color |
  | <back:#E3F2FD>  </back> Gestión de Usuarios | Azul |
  | <back:#E8F5E9>  </back> Gestión de Inventario | Verde |
  | <back:#FFF3E0>  </back> Gestión de Préstamos y Reservas | Naranja |
  | <back:#F3E5F5>  </back> Sistema de Reputación y Sanciones | Morado |
  | <back:#FBE9E7>  </back> Sistema de Garantías | Rojo |
  | <back:#E0F7FA>  </back> Sistema de Inspección | Cyan |
endlegend

@enduml
