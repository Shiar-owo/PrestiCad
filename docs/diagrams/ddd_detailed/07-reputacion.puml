@startuml
title Contexto: Reputación\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam note {
  BackgroundColor #FCE4EC
  BorderColor #C62828
  FontColor #B71C1C
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADO RAÍZ: PERFIL DE REPUTACIÓN
' ============================================================

class PerfilDeReputacion <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  usuarioId : UUID
  __ Estado __
  -puntaje : PuntajeReputacion
  -tier : Tier
  __ Metadata __
  fechaUltimaActualizacion : DateTime
  --
  +registrarDevolucion(prestamo, material) : void
  +aplicarSancion(sancion) : void
  +otorgarExcepcionAcademica(excepcion) : void
  +esElegiblePara(tierRequerido) : Boolean
  +obtenerTier() : Tier
  +obtenerPuntaje() : Integer
  +recalcularTier() : void
}

class PuntajeReputacion <<Value Object>> {
  __ Constantes __
  {static} RANGO_MIN = -500
  {static} RANGO_MAX = 500
  {static} INICIAL = 0
  __ Estado __
  valor : Integer
  --
  +sumar(puntos) : PuntajeReputacion
  +restar(puntos) : PuntajeReputacion
  +estaEnRango() : Boolean
}

class Tier <<Value Object>> {
  __ Niveles __
  AVANZADO [201..500]
  ESTANDAR [-50..200]
  RESTRINGIDO [-500..-51]
  __ Estado __
  nivel : Enum
  rangoMin : Integer
  rangoMax : Integer
  --
  +calcularDesde(puntaje) : Tier
  +tieneAccesoCompleto() : Boolean
  +puedeSolicitarEquipos() : Boolean
  +tieneDerechoProrrogas() : Boolean
}

' ============================================================
' AGREGADO RAÍZ: SANCIONES
' ============================================================

class Sancion <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  perfilDeReputacionId : UUID
  __ Clasificacion __
  -tipo : TipoSancion
  __ Impacto __
  puntosDescuento : Integer
  cobroEconomico : Decimal
  suspensionTemporal : Boolean
  diasSuspension : Integer
  __ Metadata __
  fechaAplicacion : DateTime
  descripcion : String
  activa : Boolean
  --
  +calcular(prestamo, material) : Sancion
  +aplicarA(perfil) : void
  +esPorDano() : Boolean
  +generarCobro(monto) : void
  +desactivar() : void
}

class TipoSancion <<Value Object>> {
  TARDANZA
  DANO_PARCIAL
  DANO_TOTAL
  INASISTENCIA_RESERVA
  --
  +requiereCobroEconomico() : Boolean
  +aplicaSuspension() : Boolean
}

class CalculoSancion <<Value Object>> {
  puntosBase : Integer
  factorTiempo : Decimal
  factorDano : Decimal
  montoReparacion : Decimal
  montoReposicion : Decimal
  --
  +calcularPuntosTardanza(dias, deduccion) : Integer
  +calcularPuntosDano(tipo, deduccion) : Integer
  +calcularBonificacion(dias, bonif) : Integer
}

' ============================================================
' AGREGADO RAÍZ: EXCEPCIÓN ACADÉMICA
' ============================================================

class ExcepcionAcademica <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  usuarioId : UUID
  __ Datos __
  motivo : String
  fechaInicio : DateTime
  fechaFin : DateTime
  __ Estado __
  activa : Boolean
  --
  +registrar(usuario, motivo, vigencia) : ExcepcionAcademica
  +estaVigente() : Boolean
  +anularTierMinimo() : Boolean
  +desactivar() : void
}

' ============================================================
' RELACIONES (todas por referencia, no composición)
' ============================================================

PerfilDeReputacion *-- PuntajeReputacion
PerfilDeReputacion *-- Tier
Sancion *-- TipoSancion
Sancion *-- CalculoSancion

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of PerfilDeReputacion
  <b>Aggregate Root — 4 razones de separación:</b>
  ═══════════════════════════════════════
  1. <b>Invariante:</b> puntaje y Tier siempre
     sincronizados. No puede existir
     puntaje=450 + Tier=Restringido.
  2. <b>Razón de cambio distinta:</b> cambia por
     devoluciones y sanciones (frecuente),
     no por datos administrativos.
  3. <b>Concurrencia acotada:</b> dos devoluciones
     simultáneas no bloquean la fila
     completa del usuario.
  4. <b>Comportamiento propio:</b> registrarDevolucion(),
     esElegiblePara(), otorgarExcepcionAcademica().
  ──────────────────────────────────────
  Relación 1:1 por referencia con Usuario:
  PerfilDeReputacion.usuarioId → Usuario.id
end note

note bottom of Sancion
  <b>Aggregate Root — 4 razones de separación:</b>
  ═══════════════════════════════════════
  1. <b>Invariante:</b> suspensionTemporal=true
     implica diasSuspension > 0.
     activa=false → no modificable.
  2. <b>Razón de cambio distinta:</b> cada
     devolución genera sanción nueva.
  3. <b>Concurrencia acotada:</b> sanciones
     independientes no bloquean el
    PerfilDeReputacion.
  4. <b>Comportamiento propio:</b> calcular(),
     aplicarA(), generarCobro().
  ──────────────────────────────────────
  Relación N:1 por referencia:
  Sancion.perfilDeReputacionId
    → PerfilDeReputacion.id
end note

note left of ExcepcionAcademica
  <b>Aggregate Root — Excepción Académica</b>
  ═══════════════════════════════════════
  Anula temporalmente el Tier mínimo
  requerido. Requiere:
  ● Documento de identidad
  ● Compromiso firmado
  ──────────────────────────────────────
  <i>Condiciones de otorgamiento:</i>
  • Docente o Administrativo
  • Excepción vigente
  • Sin deudas pendientes
  ──────────────────────────────────────
  Relación 1:1 por referencia:
  ExcepcionAcademica.usuarioId → Usuario.id
end note

note bottom of Tier
  <b>RN03 - Sistema de Tiers</b>
  ═══════════════════════════════════════
  AVANZADO [201..500]
    Acceso total, prioridad, prórrogas
  ESTANDAR [-50..200]
    Libros y equipos estándar
  RESTRINGIDO [-500..-51]
    Solo materiales básicos
end note

@enduml
