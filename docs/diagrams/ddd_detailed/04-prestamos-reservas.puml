@startuml
title Contexto: Préstamos\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam class<<Entity>> {
  BackgroundColor #E1F5FE
  BorderColor #0288D1
  FontColor #01579B
}

skinparam note {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADOS Y OBJETOS DE VALOR
' ============================================================

class Prestamo <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  __ Fechas __
  fechaEntrega : DateTime
  fechaLimiteDevolucion : DateTime
  tiempoPrestamoDias : Integer
  __ Estado __
  -estado : EstadoPrestamo
  activo : Boolean
  __ Observaciones __
  observaciones : String
  --
  +crear(usuario, material, dias) : Prestamo
  +activar(garantia) : void
  +devolver() : void
  +vencer() : void
  +solicitarProrroga(disp, tier) : Boolean
  +calcularDiasRestantes() : Integer
}

class EstadoPrestamo <<Value Object>> {
  RESERVADO
  ACTIVO
  DEVUELTO
  VENCIDO
  --
  +transicionesPermitidas() : List
}

class Prorroga <<Entity>> {
  id : UUID
  fechaSolicitud : DateTime
  diasExtension : Integer
  aprobada : Boolean
  motivo : String
  --
  +solicitar(prestamo, tier) : Boolean
  +aprobar() : void
  +rechazar(motivo) : void
}

class Checklist <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  prestamoId : UUID
  __ Clasificacion __
  -tipo : TipoChecklist
  __ Inspeccion __
  fechaInspeccion : DateTime
  inspectorId : UUID
  observaciones : String
  fotosUrls : List
  completo : Boolean
  --
  +crearInicial(prestamo, gestor) : Checklist
  +crearDevolucion(prestamo, gestor) : Checklist
  +compararCon(inicial) : ResultadoComparacion
  +estaCompleto() : Boolean
}

class TipoChecklist <<Value Object>> {
  ESTADO_INICIAL
  ESTADO_DEVOLUCION
}

class ResultadoComparacion <<Value Object>> {
  tieneDanoNuevo : Boolean
  defectosEncontrados : List
  defectosPreexistentes : List
  danoParcial : Boolean
  danoTotal : Boolean
  --
  +hayDano() : Boolean
  +generarSancion() : Sancion
}

class Defecto <<Value Object>> {
  descripcion : String
  ubicacion : String
  severidad : Enum
  fotoUrl : String
}

' ============================================================
' RELACIONES
' ============================================================

Prestamo *-- EstadoPrestamo
Prestamo "0..*" -- Prorroga
Prestamo "1" --> "2" Checklist
Checklist *-- TipoChecklist
Checklist "1" *-- "1..*" Defecto
Checklist "0..1" *-- ResultadoComparacion

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of Prestamo
  <b>RF07 - Estados del Préstamo</b>
  ═══════════════════════════════════════
  RESERVADO → ACTIVO → DEVUELTO
                  ↘ VENCIDO
  ──────────────────────────────────────
  <b>RN07 - Prórrogas</b>
  Condicionadas a:
  • Disponibilidad del bien
  • Tier de reputación del usuario
  Prioridad para Tier Avanzado
end note

note bottom of Checklist
  <b>RN09 - Checklist Digital</b>
  ═══════════════════════════════════════
  ● Obligatorio al entregar (CU03)
  ● Obligatorio al devolver (CU04)
  ● Sanciones solo por daños NUEVOS
  ● Se contrasta vs. estado inicial
  ──────────────────────────────────────
  El checklist nace y muere en la
  transacción del préstamo (CU03→CU04)
end note

note bottom of Prorroga
  <b>RF12 - Solicitud de Prórroga</b>
  ═══════════════════════════════════════
  Evaluación automática de elegibilidad:
  • Tier de reputación del usuario
  • Disponibilidad del bien
  • Prioridad para Tier Avanzado
end note

@enduml
