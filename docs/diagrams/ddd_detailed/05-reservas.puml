@startuml
title Contexto: Reservas\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam note {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADOS Y OBJETOS DE VALOR
' ============================================================

class Reserva <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  __ Datos __
  fechaSolicitud : DateTime
  fechaHoraRecojo : DateTime
  fechaLimiteRecojo : DateTime
  fechaLimiteEspera : DateTime
  justificacion : String
  esExcepcion : Boolean
  motivoRechazo : String
  instanciaAsignadaId : UUID
  __ Clasificacion __
  -prioridad : PrioridadReserva
  -estado : EstadoReserva
  __ Metadata __
  fechaCreacion : DateTime
  fechaActualizacion : DateTime
  activa : Boolean
  --
  +crear(usuario, material, prioridad, justificacion) : Reserva
  +confirmar(instanciaId) : void
  +entrarEnEspera() : void
  +promover(instanciaId) : void
  +aprobarExcepcion(instanciaId) : void
  +rechazar(motivo) : void
  +expirarEspera() : void
  +cancelarPorVencimiento() : void
  +convertirAPrestamo() : Prestamo
  +estaVigente() : Boolean
  +expiro() : Boolean
  +puedeAutopromoverse() : Boolean
}

class EstadoReserva <<Value Object>> {
  EN_ESPERA
  RESERVADA
  EXPIRADA
  RECHAZADA
  CANCELADA
  CANCELADA_POR_VENCIMIENTO
  CONVERTIDA_EN_PRESTAMO
  --
  +estaActiva() : Boolean
  +consumeInventario() : Boolean
  +puedeAutopromoverse() : Boolean
}

class PrioridadReserva <<Value Object>> {
  ALTA
  MEDIA
  BAJA
  --
  +esPrioritaria() : Boolean
}

' ============================================================
' RELACIONES
' ============================================================

Reserva *-- EstadoReserva
Reserva *-- PrioridadReserva

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of Reserva
  <b>RN01 - Disponibilidad</b>
  ═══════════════════════════════════════
  Sin instancia disponible no se rechaza:
  la solicitud queda en "En Espera"
  ──────────────────────────────────────
  Una reserva confirmada o un préstamo
  requiere una instancia física real.
  La espera no consume inventario ni
  garantiza disponibilidad inmediata.
end note

note right of Reserva
  <b>RN11 - Cola y Autopromoción</b>
  ═══════════════════════════════════════
  Orden de promoción:
  1. Prioridad (Alta/Media/Baja)
  2. Fecha de solicitud más antigua
  3. Tier (Avanzado/Estándar/Restringido)
  ──────────────────────────────────────
  Disparadores: devolución, cancelación,
  vencimiento, mantenimiento→disponible,
  alta de ejemplar y revisión periódica.
  ──────────────────────────────────────
  Las excepciones NO se autopromueven:
  solo las aprueba el Gestor de Almacén.
end note

note right of PrioridadReserva
  <b>RN08 - Control de Concurrencia</b>
  ═══════════════════════════════════════
  Auto-confirmación y autopromoción
  atómicas para evitar race conditions
  sobre la última instancia disponible.
  ──────────────────────────────────────
  No se asigna una misma instancia a dos
  reservas ni se salta el orden de cola.
end note

note left of EstadoReserva
  <b>RN04 - Vigencia</b>
  ═══════════════════════════════════════
  Reserva confirmada: 24 h desde
  confirmación o aprobación.
  Sin recojo → "Cancelada por Vencimiento",
  libera instancia y aplica penalización.
  ──────────────────────────────────────
  Solicitud en espera: 72 h desde creación.
  Al vencer → "Expirada" sin penalización.
end note

note bottom of Reserva
  <b>RN03 / RN05 - Excepción Académica</b>
  ═══════════════════════════════════════
  Usuario Restringido + material de Tier
  superior: puede solicitar reserva o
  préstamo excepcional con documento de
  identidad y compromiso firmado.
  ──────────────────────────────────────
  La garantía se registra al solicitar la
  reserva y se reutiliza al convertirla
  en préstamo. El Gestor valida y aprueba.
  ──────────────────────────────────────
  <b>RF04 / CU02 / CU05 / CU06</b>
  Reservar, expirar y gestionar la cola.
end note

@enduml
