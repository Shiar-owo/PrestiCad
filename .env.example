# Base de datos
POSTGRES_DB=presticad
POSTGRES_USER=presticad
POSTGRES_PASSWORD=presticad

# Django
DATABASE_URL=postgresql://presticad:presticad@db:5432/presticad
DEBUG=True
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS (orígenes permitidos para el frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Imágenes (HU04). En desarrollo se guardan en backend/media/ y el backend
# está publicado en el puerto 8000, de ahí el origen público por defecto.
# En producción estas variables no se usan: development.py corre con disco y
# production.py con Cloudinary.
MEDIA_URL_PUBLICA=http://localhost:8000

# Cloudinary: obligatorias solo en producción. Se pegan desde la consola de
# Cloudinary, en Settings > API Keys. CLOUDINARY_URL es la forma alternativa
# de pasarlas todas juntas (cloudinary://<key>:<secret>@<cloud>).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=