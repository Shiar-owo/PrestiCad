# Configuración para desarrollo local con docker compose.

# Base de datos local
POSTGRES_DB=presticad
POSTGRES_USER=presticad
POSTGRES_PASSWORD=presticad
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Imágenes públicas (HU04): el backend local está publicado en el puerto 8000.
MEDIA_URL_PUBLICA=http://localhost:8000

# Documentos de garantía: en desarrollo se guardan en disco local.
GARANTIAS_STORAGE_ROOT=/app/privado/garantias

# Límite por archivo (4 MB). La suma total de cada solicitud también se limita a 4 MB.
GARANTIA_TAMANO_MAXIMO_BYTES=4194304
