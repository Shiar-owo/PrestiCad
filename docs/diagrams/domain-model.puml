@startuml
' ============================================================
' Modelo de Dominio DDD - Sistema de Prestamos Academicos
' Universidad Nacional San Agustin de Arequipa
' Grupo 6 - Trabajo Interdisciplinar II
' ============================================================

title Modelo de Dominio - Sistema de Prestamos Academicos\n<size:10>Grupo 6 - Trabajo Interdisciplinar II - UNSA</size>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  packageStyle rectangle
  padding 8
  roundcorner 10
}

' --- Paleta de colores por subdominio ---
skinparam package<<Subdomain Acceso>> {
  FontSize 14
  FontStyle bold
  BorderThickness 3
  RoundCorner 15
  BackgroundColor #E8EAF6
  BorderColor #3F51B5
  FontColor #1A237E
}

skinparam package<<Subdomain Reputación>> {
  FontSize 14
  FontStyle bold
  BorderThickness 3
  RoundCorner 15
  BackgroundColor #FCE4EC
  BorderColor #C62828
  FontColor #B71C1C
}

skinparam package<<Subdomain Préstamos>> {
  FontSize 14
  FontStyle bold
  BorderThickness 3
  RoundCorner 15
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
}

skinparam package<<Subdomain Bienes>> {
  FontSize 14
  FontStyle bold
  BorderThickness 3
  RoundCorner 15
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}

skinparam package<<Bounded Context>> {
  FontSize 12
  BorderThickness 1
  RoundCorner 8
}

' --- Estilos de clases ---
skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam class<<Entity>> {
  BackgroundColor #E1F5FE
  BorderColor #0288D1
  FontColor #01579B
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #FBC02D
  FontColor #5D4037
  FontSize 10
  BorderThickness 1
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #BDBDBD
  FontSize 10
}

' ============================================================
' SUBDOMINIO: IDENTIDAD Y ACCESO (Generic)
' ============================================================
package "  Identidad y Acceso  " <<Subdomain Acceso>> as SD1 {

  package "  Usuarios  " <<Bounded Context>> as BC1 {

    class Usuario <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      nombre : String
      email : String
      contrasena : String
      __ Estado __
      activo : Boolean
      fechaRegistro : DateTime
      __ Dominio __
      -tipoUsuario : TipoUsuario
      -perfil : Perfil
      --
      +registrar(tipo) : Usuario
      +actualizarPerfil(datos) : void
      +estaActivo() : Boolean
    }

    class TipoUsuario <<Value Object>> {
      ALUMNO
      DOCENTE
      ADMINISTRATIVO
      GESTOR_ALMACEN
      ADMINISTRADOR_SISTEMA
    }

    class Perfil <<Value Object>> {
      telefono : String
      direccion : String
      carrera : String
      departamento : String
    }

    Usuario *-- TipoUsuario
    Usuario *-- Perfil
  }
}

' ============================================================
' SUBDOMINIO: REPUTACIÓN Y CONFIANZA (Core)
' ============================================================
package "  Reputación y Confianza  " <<Subdomain Reputación>> as SD2 {

  package "  Reputación  " <<Bounded Context>> as BC2 {

    class PerfilDeReputacion <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      usuarioId : UUID
      __ Estado __
      -puntaje : PuntajeReputacion
      -tier : Tier
      __ Metadata __
      fechaUltimaActualizacion : DateTime
      --
      +registrarDevolucion(prestamo, material) : void
      +aplicarSancion(sancion) : void
      +otorgarExcepcionAcademica(excepcion) : void
      +esElegiblePara(tierRequerido) : Boolean
      +obtenerTier() : Tier
      +obtenerPuntaje() : Integer
      +recalcularTier() : void
    }

    class PuntajeReputacion <<Value Object>> {
      __ Constantes __
      {static} RANGO_MIN = -500
      {static} RANGO_MAX = 500
      {static} INICIAL = 0
      __ Estado __
      valor : Integer
      --
      +sumar(puntos) : PuntajeReputacion
      +restar(puntos) : PuntajeReputacion
      +estaEnRango() : Boolean
    }

    class Tier <<Value Object>> {
      __ Niveles __
      AVANZADO [201..500]
      ESTANDAR [-50..200]
      RESTRINGIDO [-500..-51]
      __ Estado __
      nivel : Enum
      rangoMin : Integer
      rangoMax : Integer
      --
      +calcularDesde(puntaje) : Tier
      +tieneAccesoCompleto() : Boolean
      +puedeSolicitarEquipos() : Boolean
      +tieneDerechoProrrogas() : Boolean
    }

    class Sancion <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      perfilDeReputacionId : UUID
      __ Clasificacion __
      -tipo : TipoSancion
      __ Impacto __
      puntosDescuento : Integer
      cobroEconomico : Decimal
      suspensionTemporal : Boolean
      diasSuspension : Integer
      __ Metadata __
      fechaAplicacion : DateTime
      descripcion : String
      activa : Boolean
      --
      +calcular(prestamo, material) : Sancion
      +aplicarA(perfil) : void
      +esPorDano() : Boolean
      +generarCobro(monto) : void
      +desactivar() : void
    }

    class TipoSancion <<Value Object>> {
      TARDANZA
      DANO_PARCIAL
      DANO_TOTAL
      INASISTENCIA_RESERVA
      --
      +requiereCobroEconomico() : Boolean
      +aplicaSuspension() : Boolean
    }

    class CalculoSancion <<Value Object>> {
      __ Parametros __
      puntosBase : Integer
      factorTiempo : Decimal
      factorDano : Decimal
      montoReparacion : Decimal
      montoReposicion : Decimal
      --
      +calcularPuntosTardanza(dias, deduccion) : Integer
      +calcularPuntosDano(tipo, deduccion) : Integer
      +calcularBonificacion(dias, bonif) : Integer
    }

    class ExcepcionAcademica <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      usuarioId : UUID
      __ Datos __
      motivo : String
      fechaInicio : DateTime
      fechaFin : DateTime
      __ Estado __
      activa : Boolean
      --
      +registrar(usuario, motivo, vigencia) : ExcepcionAcademica
      +estaVigente() : Boolean
      +anularTierMinimo() : Boolean
      +desactivar() : void
    }

    PerfilDeReputacion *-- PuntajeReputacion
    PerfilDeReputacion *-- Tier
    Sancion *-- TipoSancion
    Sancion *-- CalculoSancion
  }
}

' ============================================================
' SUBDOMINIO: CICLO DE PRÉSTAMO (Core)
' ============================================================
package "  Ciclo de Préstamo  " <<Subdomain Préstamos>> as SD3 {

  package "  Reservas  " <<Bounded Context>> as BC3 {

    class Reserva <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      __ Datos __
      fechaHoraRecojo : DateTime
      justificacion : String
      __ Clasificacion __
      -prioridad : PrioridadReserva
      -estado : EstadoReserva
      __ Metadata __
      fechaCreacion : DateTime
      activa : Boolean
      --
      +crear(usuario, material, prio, just) : Reserva
      +cancelarPorVencimiento() : void
      +convertirAPrestamo() : Prestamo
      +estaVigente() : Boolean
      +expiro() : Boolean
    }

    class EstadoReserva <<Value Object>> {
      RESERVADA
      CANCELADA_POR_VENCIMIENTO
      CONVERTIDA_EN_PRESTAMO
    }

    class PrioridadReserva <<Value Object>> {
      ALTA
      MEDIA
      BAJA
      --
      +esPrioritaria() : Boolean
    }

    Reserva *-- EstadoReserva
    Reserva *-- PrioridadReserva
  }

  package "  Préstamos  " <<Bounded Context>> as BC4 {

    class Prestamo <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      __ Fechas __
      fechaEntrega : DateTime
      fechaLimiteDevolucion : DateTime
      tiempoPrestamoDias : Integer
      __ Estado __
      -estado : EstadoPrestamo
      activo : Boolean
      __ Observaciones __
      observaciones : String
      --
      +crear(usuario, material, dias) : Prestamo
      +activar(garantia) : void
      +devolver() : void
      +vencer() : void
      +solicitarProrroga(disp, tier) : Boolean
      +calcularDiasRestantes() : Integer
    }

    class EstadoPrestamo <<Value Object>> {
      RESERVADO
      ACTIVO
      DEVUELTO
      VENCIDO
      --
      +transicionesPermitidas() : List
    }

    class Prorroga <<Entity>> {
      id : UUID
      fechaSolicitud : DateTime
      diasExtension : Integer
      aprobada : Boolean
      motivo : String
      --
      +solicitar(prestamo, tier) : Boolean
      +aprobar() : void
      +rechazar(motivo) : void
    }

    class Checklist <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      prestamoId : UUID
      __ Clasificacion __
      -tipo : TipoChecklist
      __ Inspeccion __
      fechaInspeccion : DateTime
      inspectorId : UUID
      observaciones : String
      fotosUrls : List
      completo : Boolean
      --
      +crearInicial(prestamo, gestor) : Checklist
      +crearDevolucion(prestamo, gestor) : Checklist
      +compararCon(inicial) : ResultadoComparacion
      +estaCompleto() : Boolean
    }

    class TipoChecklist <<Value Object>> {
      ESTADO_INICIAL
      ESTADO_DEVOLUCION
    }

    class ResultadoComparacion <<Value Object>> {
      tieneDanoNuevo : Boolean
      defectosEncontrados : List
      defectosPreexistentes : List
      danoParcial : Boolean
      danoTotal : Boolean
      --
      +hayDano() : Boolean
      +generarSancion() : Sancion
    }

    class Defecto <<Value Object>> {
      descripcion : String
      ubicacion : String
      severidad : Enum
      fotoUrl : String
    }

    Prestamo *-- EstadoPrestamo
    Prestamo "0..*" -- Prorroga
    Prestamo "1" --> "2" Checklist
    Checklist *-- TipoChecklist
    Checklist "1" *-- "1..*" Defecto
    Checklist "0..1" *-- ResultadoComparacion
  }

  package "  Garantías  " <<Bounded Context>> as BC5 {

    class Garantia <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      __ Clasificacion __
      -tipo : TipoGarantia
      -estado : EstadoGarantia
      __ Datos __
      fechaRegistro : DateTime
      fechaLiberacion : DateTime
      descripcionCompromiso : String
      documentoUrl : String
      activa : Boolean
      --
      +registrar(usuario, prestamo, tipo) : Garantia
      +liberar() : void
      +verificar() : Boolean
      +estaRegistrada() : Boolean
    }

    class TipoGarantia <<Value Object>> {
      DOCUMENTO_IDENTIDAD
      COMPROMISO_RESPONSABILIDAD
      DOCUMENTO_Y_COMPROMISO
      --
      +esDocumental() : Boolean
    }

    class EstadoGarantia <<Value Object>> {
      PENDIENTE
      REGISTRADA
      LIBERADA
      RETENIDA
      --
      +estaActiva() : Boolean
    }

    class CompromisoResponsabilidad <<Value Object>> {
      contenido : String
      fechaFirma : DateTime
      firmaUrl : String
      testigo : String
      --
      +esValido() : Boolean
    }

    Garantia *-- TipoGarantia
    Garantia *-- EstadoGarantia
    Garantia "0..1" *-- CompromisoResponsabilidad
  }
}

' ============================================================
' SUBDOMINIO: BIENES Y CONSERVACIÓN (Supporting)
' ============================================================
package "  Bienes y Conservación  " <<Subdomain Bienes>> as SD4 {

  package "  Inventario  " <<Bounded Context>> as BC6 {

    class Material <<Aggregate Root>> {
      --
      __ Identidad __
      id : UUID
      nombre : String
      descripcion : String
      codigoInventario : String
      __ Clasificacion __
      -tipo : TipoMaterial
      -estado : EstadoMaterial
      esAltoValor : Boolean
      __ Configuracion __
      -atributosRep : AtributosReputacion
      __ Metadata __
      fechaRegistro : DateTime
      --
      +cambiarEstado(nuevo) : void
      +estaDisponible() : Boolean
      +requiereGarantia() : Boolean
      +obtenerTierMinimo() : Tier
    }

    class EstadoMaterial <<Value Object>> {
      DISPONIBLE
      EN_MANTENIMIENTO
      RESERVADO
      PRESTADO
      --
      +esDisponible() : Boolean
      +puedePrestarse() : Boolean
    }

    class TipoMaterial <<Value Object>> {
      EQUIPO
      LIBRO
      OBJETO
    }

    class FichaTecnica <<Value Object>> {
      marca : String
      modelo : String
      numeroSerie : String
      color : String
      estadoFisico : String
      fotoUrl : String
    }

    class AtributosReputacion <<Value Object>> {
      __ Penalizaciones __
      tierMinimoRequerido : Tier
      bonificacionTiempo : Integer
      deduccionTardanza : Integer
      deduccionDanoParcial : Integer
      deduccionDanoTotal : Integer
      __ Costos __
      costoReparacion : Decimal
      costoReposicion : Decimal
      --
      +calcularBonificacion() : Integer
      +calcularDeduccionTardanza(dias) : Integer
      +calcularDeduccionDano(tipo) : Integer
    }

    Material *-- EstadoMaterial
    Material *-- TipoMaterial
    Material "0..1" *-- FichaTecnica
    Material *-- AtributosReputacion
  }
}

' ============================================================
' RELACIONES ENTRE BOUNDED CONTEXTS
' ============================================================

' --- Usuarios → todos (Upstream/Conformist) ---
Usuario "1" --> "0..*" Reserva
Usuario "1" --> "0..*" Prestamo

' --- Inventario ↔ Préstamos/Reservas ---
Material "1" --> "0..*" Reserva
Material "1" --> "0..*" Prestamo

' --- Reservas → Préstamos ---
Reserva "1" --> "1..*" Prestamo

' --- Préstamos → Garantías ---
Prestamo "1" --> "0..1" Garantia

' --- Préstamos → Reputación ---
Prestamo "1" --> "0..*" Sancion

' --- Reputación → Usuarios (referencia por usuarioId) ---
PerfilDeReputacion "1" --> "1" Usuario

' ============================================================
' REGLAS DE NEGOCIO CLAVE
' ============================================================

note top of SD1
  <b>RN03 - Reputación y Tiers</b>
  Rango: [-500, 500] | Inicio: 0
  ─────────────────────────────
  ● Avanzado [201..500]
    Acceso total, prioridad, prórrogas
  ● Estándar [-50..200]
    Libros y equipos estándar
  ● Restringido [-500..-51]
    Solo materiales básicos
  ─────────────────────────────
  <i>Excepción Académica:</i>
  Doc. identidad + Compromiso firmado
end note

note bottom of SD4
  <b>RN01 - Disponibilidad</b>
  Solo se presta si estado = "Disponible"
  ─────────────────────────────
  <b>RN05 - Garantía</b>
  Equipos alto valor requieren
  documento + compromiso firmado
end note

note right of SD3
  <b>RN04 - Vigencia Reservas</b>
  Máximo 24h desde recojo
  Sin recoger → Cancelada
  ─────────────────────────────
  <b>RN07 - Prórrogas</b>
  Según Tier y disponibilidad
  ─────────────────────────────
  <b>RN08 - Concurrencia</b>
  Transacciones atómicas
  ─────────────────────────────
  <b>RN09 - Checklist</b>
  Obligatorio entregar/devolver
  Sanciones solo por daños NUEVOS
end note

note left of SD2
  <b>RN06 - Cálculo Dinámico</b>
  ─────────────────────────────
  ● Bonificación por entrega a tiempo
  ● Descuento proporcional tardanza
  ● Penalización severa por daño
  ─────────────────────────────
  <b>RF08 - Cobros</b>
  SOLO por daño físico
end note

' ============================================================
' LEYENDA
' ============================================================

legend bottom
  |= Elemento |= Descripción |
  | <back:#FFF9C4><color:#F57F17><b>Aggregate Root</b></back> | Raíz de agregado (entidad principal) |
  | <back:#FFFFFF><color:#37474F><i>Value Object</i></back> | Objeto de valor (inmutable) |
  | <back:#E1F5FE><color:#01579B><b>Entity</b></back> | Entidad con identidad propia |
  | <color:#455A64>──►</color> | Relación de dominio |
  ─────────────────────────────
  |= Subdominio |= Tipo |
  | <back:#E8EAF6><color:#1A237E>Identidad y Acceso</color></back> | <color:#90A4AE><i>Generic</i></color> |
  | <back:#FCE4EC><color:#B71C1C>Reputación y Confianza</color></back> | <color:#F57F17><b>Core</b></color> |
  | <back:#FFF3E0><color:#BF360C>Ciclo de Préstamo</color></back> | <color:#F57F17><b>Core</b></color> |
  | <back:#E8F5E9><color:#1B5E20>Bienes y Conservación</color></back> | <color:#2E7D32><b>Supporting</b></color> |
endlegend

@enduml
