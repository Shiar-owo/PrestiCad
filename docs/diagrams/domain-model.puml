@startuml
' ============================================================
' Modelo de Dominio DDD - Sistema de Prestamos Academicos
' Universidad Nacional San Agustin de Arequipa
' Grupo 6 - Trabajo Interdisciplinar II
' ============================================================

title Modelo de Dominio - Sistema de Prestamos Academicos\n<size:10>Grupo 6 - Trabajo Interdisciplinar II - UNSA</size>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  packageStyle rectangle
  padding 8
  roundcorner 10
}

' --- Paleta de colores por contexto ---
skinparam package<<context>> {
  FontSize 14
  FontStyle bold
  BorderThickness 2
  RoundCorner 15
}

skinparam package<<ctx-usuario>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
}

skinparam package<<ctx-inventario>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}

skinparam package<<ctx-prestamos>> {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
}

skinparam package<<ctx-reputacion>> {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
  FontColor #4A148C
}

skinparam package<<ctx-garantia>> {
  BackgroundColor #FBE9E7
  BorderColor #BF360C
  FontColor #BF360C
}

skinparam package<<ctx-inspeccion>> {
  BackgroundColor #E0F7FA
  BorderColor #00695C
  FontColor #004D40
}

' --- Estilos de clases ---
skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam class<<Entity>> {
  BackgroundColor #E1F5FE
  BorderColor #0288D1
  FontColor #01579B
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #FBC02D
  FontColor #5D4037
  FontSize 10
  BorderThickness 1
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #BDBDBD
  FontSize 10
}

' ============================================================
' CONTEXTO 1: GESTION DE USUARIOS
' ============================================================
package "  Gestión de Usuarios  " <<ctx-usuario>> as CTX1 {

  class Usuario <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    nombre : String
    email : String
    contrasena : String
    __ Estado __
    activo : Boolean
    fechaRegistro : DateTime
    __ Dominio __
    -tipoUsuario : TipoUsuario
    -perfil : Perfil
    -puntaje : PuntajeReputacion
    -tier : Tier
    -historial : HistorialPrestamos
    --
    +registrar(tipo) : Usuario
    +actualizarPerfil(datos) : void
    +obtenerPuntaje() : PuntajeReputacion
    +obtenerTier() : Tier
    +estaActivo() : Boolean
  }

  class TipoUsuario <<Value Object>> {
    ALUMNO
    DOCENTE
    ADMINISTRATIVO
    GESTOR_ALMACEN
    ADMINISTRADOR_SISTEMA
  }

  class Perfil <<Value Object>> {
    telefono : String
    direccion : String
    carrera : String
    departamento : String
  }

  class PuntajeReputacion <<Value Object>> {
    __ Constantes __
    {static} RANGO_MIN = -500
    {static} RANGO_MAX = 500
    {static} INICIAL = 0
    __ Estado __
    valor : Integer
    --
    +sumar(puntos) : PuntajeReputacion
    +restar(puntos) : PuntajeReputacion
    +estaEnRango() : Boolean
  }

  class Tier <<Value Object>> {
    __ Niveles __
    AVANZADO [201..500]
    ESTANDAR [-50..200]
    RESTRINGIDO [-500..-51]
    __ Estado __
    nivel : Enum
    rangoMin : Integer
    rangoMax : Integer
    --
    +calcularDesde(puntaje) : Tier
    +tieneAccesoCompleto() : Boolean
    +puedeSolicitarEquipos() : Boolean
    +tieneDerechoProrrogas() : Boolean
  }

  class HistorialPrestamos <<Value Object>> {
    totalPrestamos : Integer
    prestamosActivos : Integer
    prestamosDevueltos : Integer
    prestamosVencidos : Integer
  }

  Usuario *-- TipoUsuario
  Usuario *-- Perfil
  Usuario *-- PuntajeReputacion
  Usuario *-- Tier
  Usuario *-- HistorialPrestamos
}

' ============================================================
' CONTEXTO 2: GESTION DE INVENTARIO
' ============================================================
package "  Gestión de Inventario  " <<ctx-inventario>> as CTX2 {

  class Material <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    nombre : String
    descripcion : String
    codigoInventario : String
    __ Clasificacion __
    -tipo : TipoMaterial
    -estado : EstadoMaterial
    esAltoValor : Boolean
    __ Configuracion __
    -atributosRep : AtributosReputacion
    __ Metadata __
    fechaRegistro : DateTime
    --
    +cambiarEstado(nuevo) : void
    +estaDisponible() : Boolean
    +requiereGarantia() : Boolean
    +obtenerTierMinimo() : Tier
  }

  class EstadoMaterial <<Value Object>> {
    DISPONIBLE
    EN_MANTENIMIENTO
    RESERVADO
    PRESTADO
    --
    +esDisponible() : Boolean
    +puedePrestarse() : Boolean
  }

  class TipoMaterial <<Value Object>> {
    EQUIPO
    LIBRO
    OBJETO
  }

  class FichaTecnica <<Value Object>> {
    marca : String
    modelo : String
    numeroSerie : String
    color : String
    estadoFisico : String
    fotoUrl : String
  }

  class AtributosReputacion <<Value Object>> {
    __ Penalizaciones __
    tierMinimoRequerido : Tier
    bonificacionTiempo : Integer
    deduccionTardanza : Integer
    deduccionDanoParcial : Integer
    deduccionDanoTotal : Integer
    __ Costos __
    costoReparacion : Decimal
    costoReposicion : Decimal
    --
    +calcularBonificacion() : Integer
    +calcularDeduccionTardanza(dias) : Integer
    +calcularDeduccionDano(tipo) : Integer
  }

  Material *-- EstadoMaterial
  Material *-- TipoMaterial
  Material "0..1" *-- FichaTecnica
  Material *-- AtributosReputacion
}

' ============================================================
' CONTEXTO 3: GESTION DE PRESTAMOS Y RESERVAS
' ============================================================
package "  Gestión de Préstamos y Reservas  " <<ctx-prestamos>> as CTX3 {

  class Prestamo <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    __ Fechas __
    fechaEntrega : DateTime
    fechaLimiteDevolucion : DateTime
    tiempoPrestamoDias : Integer
    __ Estado __
    -estado : EstadoPrestamo
    activo : Boolean
    __ Observaciones __
    observaciones : String
    --
    +crear(usuario, material, dias) : Prestamo
    +activar(garantia) : void
    +devolver(checklist) : void
    +vencer() : void
    +solicitarProrroga(disp, tier) : Boolean
    +calcularDiasRestantes() : Integer
  }

  class EstadoPrestamo <<Value Object>> {
    RESERVADO
    ACTIVO
    DEVUELTO
    VENCIDO
    --
    +transicionesPermitidas() : List
  }

  class Reserva <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    __ Datos __
    fechaHoraRecojo : DateTime
    justificacion : String
    __ Clasificacion __
    -prioridad : PrioridadReserva
    -estado : EstadoReserva
    __ Metadata __
    fechaCreacion : DateTime
    activa : Boolean
    --
    +crear(usuario, material, prio, just) : Reserva
    +cancelarPorVencimiento() : void
    +convertirAPrestamo() : Prestamo
    +estaVigente() : Boolean
    +expiro() : Boolean
  }

  class EstadoReserva <<Value Object>> {
    RESERVADA
    CANCELADA_POR_VENCIMIENTO
    CONVERTIDA_EN_PRESTAMO
  }

  class PrioridadReserva <<Value Object>> {
    ALTA
    MEDIA
    BAJA
    --
    +esPrioritaria() : Boolean
  }

  class Prorroga <<Entity>> {
    id : UUID
    fechaSolicitud : DateTime
    diasExtension : Integer
    aprobada : Boolean
    motivo : String
    --
    +solicitar(prestamo, tier) : Boolean
    +aprobar() : void
    +rechazar(motivo) : void
  }

  Prestamo *-- EstadoPrestamo
  Prestamo "0..*" -- Prorroga
  Reserva *-- EstadoReserva
  Reserva *-- PrioridadReserva
}

' ============================================================
' CONTEXTO 4: SISTEMA DE REPUTACION Y SANCIONES
' ============================================================
package "  Sistema de Reputación y Sanciones  " <<ctx-reputacion>> as CTX4 {

  class Sancion <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    __ Clasificacion __
    -tipo : TipoSancion
    __ Impacto __
    puntosDescuento : Integer
    cobroEconomico : Decimal
    suspensionTemporal : Boolean
    diasSuspension : Integer
    __ Metadata __
    fechaAplicacion : DateTime
    descripcion : String
    activa : Boolean
    --
    +calcular(prestamo, material) : Sancion
    +aplicarA(usuario) : void
    +esPorDano() : Boolean
    +generarCobro(monto) : void
  }

  class TipoSancion <<Value Object>> {
    TARDANZA
    DANO_PARCIAL
    DANO_TOTAL
    INASISTENCIA_RESERVA
    --
    +requiereCobroEconomico() : Boolean
    +aplicaSuspension() : Boolean
  }

  class CalculoSancion <<Value Object>> {
    __ Parametros __
    puntosBase : Integer
    factorTiempo : Decimal
    factorDano : Decimal
    montoReparacion : Decimal
    montoReposicion : Decimal
    --
    +calcularPuntosTardanza(dias, deduccion) : Integer
    +calcularPuntosDano(tipo, deduccion) : Integer
    +calcularBonificacion(dias, bonif) : Integer
  }

  Sancion *-- TipoSancion
  Sancion *-- CalculoSancion
}

' ============================================================
' CONTEXTO 5: SISTEMA DE GARANTIAS
' ============================================================
package "  Sistema de Garantías  " <<ctx-garantia>> as CTX5 {

  class Garantia <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    __ Clasificacion __
    -tipo : TipoGarantia
    -estado : EstadoGarantia
    __ Datos __
    fechaRegistro : DateTime
    fechaLiberacion : DateTime
    descripcionCompromiso : String
    documentoUrl : String
    activa : Boolean
    --
    +registrar(usuario, prestamo, tipo) : Garantia
    +liberar() : void
    +verificar() : Boolean
    +estaRegistrada() : Boolean
  }

  class TipoGarantia <<Value Object>> {
    DOCUMENTO_IDENTIDAD
    COMPROMISO_RESPONSABILIDAD
    DOCUMENTO_Y_COMPROMISO
    --
    +esDocumental() : Boolean
  }

  class EstadoGarantia <<Value Object>> {
    PENDIENTE
    REGISTRADA
    LIBERADA
    RETENIDA
    --
    +estaActiva() : Boolean
  }

  class CompromisoResponsabilidad <<Value Object>> {
    contenido : String
    fechaFirma : DateTime
    firmaUrl : String
    testigo : String
    --
    +esValido() : Boolean
  }

  Garantia *-- TipoGarantia
  Garantia *-- EstadoGarantia
  Garantia "0..1" *-- CompromisoResponsabilidad
}

' ============================================================
' CONTEXTO 6: SISTEMA DE INSPECCION
' ============================================================
package "  Sistema de Inspección  " <<ctx-inspeccion>> as CTX6 {

  class Checklist <<Aggregate Root>> {
    --
    __ Identidad __
    id : UUID
    prestamoId : UUID
    __ Clasificacion __
    -tipo : TipoChecklist
    __ Inspeccion __
    fechaInspeccion : DateTime
    inspectorId : UUID
    observaciones : String
    fotosUrls : List
    completo : Boolean
    --
    +crearInicial(prestamo, gestor) : Checklist
    +crearDevolucion(prestamo, gestor) : Checklist
    +compararCon(inicial) : ResultadoComparacion
    +estaCompleto() : Boolean
  }

  class TipoChecklist <<Value Object>> {
    ESTADO_INICIAL
    ESTADO_DEVOLUCION
  }

  class ResultadoComparacion <<Value Object>> {
    tieneDanoNuevo : Boolean
    defectosEncontrados : List
    defectosPreexistentes : List
    danoParcial : Boolean
    danoTotal : Boolean
    --
    +hayDano() : Boolean
    +generarSancion() : Sancion
  }

  class Defecto <<Value Object>> {
    descripcion : String
    ubicacion : String
    severidad : Enum
    fotoUrl : String
  }

  Checklist *-- TipoChecklist
  Checklist "1" *-- "1..*" Defecto
  Checklist "0..1" *-- ResultadoComparacion
}

' ============================================================
' RELACIONES ENTRE CONTEXTO DELIMITADOS
' ============================================================

' --- Usuarios <-> Prestamos/Reservas ---
Usuario "1" --> "0..*" Reserva
Usuario "1" --> "0..*" Prestamo

' --- Inventario <-> Prestamos/Reservas ---
Material "1" --> "0..*" Reserva
Material "1" --> "0..*" Prestamo

' --- Prestamos <-> Garantias ---
Prestamo "1" --> "0..1" Garantia

' --- Prestamos <-> Inspeccion ---
Prestamo "1" --> "2" Checklist

' --- Prestamos <-> Sanciones ---
Prestamo "1" --> "0..*" Sancion

' --- Sanciones <-> Usuarios ---
Sancion "1" --> "1" Usuario

' --- Checklist <-> Material ---
Checklist "1" --> "1" Material

' ============================================================
' REGLAS DE NEGOCIO CLAVE
' ============================================================

note top of CTX1
  <b>RN03 - Reputación y Tiers</b>
  Rango: [-500, 500] | Inicio: 0
  ─────────────────────────────
  ● Avanzado [201..500]
    Acceso total, prioridad, prórrogas
  ● Estándar [-50..200]
    Libros y equipos estándar
  ● Restringido [-500..-51]
    Solo materiales básicos
  ─────────────────────────────
  <i>Excepción Académica:</i>
  Doc. identidad + Compromiso firmado
end note

note bottom of CTX2
  <b>RN01 - Disponibilidad</b>
  Solo se presta si estado = "Disponible"
  ─────────────────────────────
  <b>RN05 - Garantía</b>
  Equipos alto valor requieren
  documento + compromiso firmado
end note

note right of CTX4
  <b>RN06 - Cálculo Dinámico</b>
  ─────────────────────────────
  ● Bonificación por entrega a tiempo
  ● Descuento proporcional tardanza
  ● Penalización severa por daño
  ─────────────────────────────
  <b>RF08 - Cobros</b>
  SOLO por daño físico
end note

note bottom of CTX6
  <b>RN09 - Checklist Digital</b>
  ─────────────────────────────
  ● Obligatorio al entregar (CU03)
  ● Obligatorio al devolver (CU04)
  ● Sanciones solo por daños NUEVOS
  ● Se contrasta vs. estado inicial
end note

note left of CTX3
  <b>RN04 - Vigencia Reservas</b>
  ─────────────────────────────
  ● Máximo 24h desde recojo
  ● Sin recoger → Cancelada
  ● Material → Disponible
  ● Penalización por inasistencia
end note

' ============================================================
' LEYENDA
' ============================================================

legend bottom
  |= Elemento |= Descripción |
  | <back:#FFF9C4><color:#F57F17><b>Aggregate Root</b></back> | Raíz de agregado (entidad principal) |
  | <back:#FFFFFF><color:#37474F><i>Value Object</i></back> | Objeto de valor (inmutable) |
  | <back:#E1F5FE><color:#01579B><b>Entity</b></back> | Entidad con identidad propia |
  | <color:#455A64>──►</color> | Relación de dominio |
endlegend

@enduml
