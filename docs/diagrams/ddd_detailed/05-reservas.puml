@startuml
title Contexto: Reservas\n<b>Modelo de Dominio DDD</b>

skinparam {
  shadowing false
  defaultFontSize 11
  defaultFontName "Segoe UI"
  classAttributeIconSize 0
  linetype ortho
  roundcorner 8
  padding 5
}

skinparam class<<Aggregate Root>> {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontColor #F57F17
  FontStyle bold
  BorderThickness 2
}

skinparam class<<Value Object>> {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontColor #37474F
  FontStyle italic
}

skinparam note {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
  FontSize 10
}

skinparam arrow {
  Color #455A64
  FontSize 9
  FontColor #546E7A
}

' ============================================================
' AGREGADOS Y OBJETOS DE VALOR
' ============================================================

class Reserva <<Aggregate Root>> {
  --
  __ Identidad __
  id : UUID
  __ Datos __
  fechaHoraRecojo : DateTime
  justificacion : String
  __ Clasificacion __
  -prioridad : PrioridadReserva
  -estado : EstadoReserva
  __ Metadata __
  fechaCreacion : DateTime
  activa : Boolean
  --
  +crear(usuario, material, prio, just) : Reserva
  +cancelarPorVencimiento() : void
  +convertirAPrestamo() : Prestamo
  +estaVigente() : Boolean
  +expiro() : Boolean
}

class EstadoReserva <<Value Object>> {
  RESERVADA
  CANCELADA_POR_VENCIMIENTO
  CONVERTIDA_EN_PRESTAMO
  --
  +estaActiva() : Boolean
}

class PrioridadReserva <<Value Object>> {
  ALTA
  MEDIA
  BAJA
  --
  +esPrioritaria() : Boolean
}

' ============================================================
' RELACIONES
' ============================================================

Reserva *-- EstadoReserva
Reserva *-- PrioridadReserva

' ============================================================
' REGLAS DE NEGOCIO
' ============================================================

note top of Reserva
  <b>RN04 - Vigencia de Reservas</b>
  ═══════════════════════════════════════
  Máximo 24 horas desde hora pactada
  de recojo
  ──────────────────────────────────────
  Sin recoger → "Cancelada por Vencimiento"
  Material vuelve a "Disponible"
  Penalización por inasistencia al
  puntaje de reputación del usuario
end note

note right of PrioridadReserva
  <b>RN08 - Control de Concurrencia</b>
  ═══════════════════════════════════════
  Reservas simultáneas para el mismo
  objeto se procesan con transacciones
  atómicas (prevenir race conditions)
  sobre la última unidad disponible
  ──────────────────────────────────────
  La prioridad y justificación sirven
  para que el Gestor evalúe y priorice
  la asignación en alta demanda
end note

note left of EstadoReserva
  <b>RF04 - Reserva</b>
  ═══════════════════════════════════════
  El usuario ingresa:
  • Material deseado
  • Prioridad (Alta/Media/Baja)
  • Justificación del uso
  ──────────────────────────────────────
  <b>CU02 - Reservar material</b>
  <b>CU05 - Cancelar vencidas</b>
end note

@enduml
